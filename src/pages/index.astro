---
// 首页内容取自 首页信息.md 的 home JSON 结构（hero / start / aboutGame / finalCta / footer）
import Layout from '../layouts/Layout.astro';
import { pages } from '../data/pages';

const featured = pages.filter((p) => ['guide', 'characters', 'story', 'dlc'].includes(p.slug));

const hero = {
  eyebrow: 'Fan-Made Community Wiki',
  title: 'Another Eden Begins',
  description:
    'Another Eden Begins is a time-traveling RPG from Wright Flyer Studios and Masato Kato, featuring command battles, 19 playable characters, New Game+, and more than 10 different endings.',
  stats: [
    { value: 'Sep 2026', label: 'Launched' },
    { value: 'Sep 17', label: 'Last updated' },
    { value: '19', label: 'Playable characters' },
    { value: '10+', label: 'Endings' },
  ],
};

const aboutStats = [
  { label: 'Developer', value: 'WRIGHT FLYER STUDIOS' },
  { label: 'Platform', value: 'Nintendo Switch · Switch 2 · Steam' },
  { label: 'Genre', value: 'Time-Traveling RPG' },
  { label: 'Playable Characters', value: '19' },
  { label: 'New Game+ Endings', value: '10+' },
  { label: 'Players', value: 'Single-player' },
];

const faqs = [
  {
    q: 'What is the game about?',
    a: 'A single-player time-traveling RPG developed by WRIGHT FLYER STUDIOS, created with scenario writer and director Masato Kato. You play as Aldo, travelling across eras to save his sister Feinne.',
  },
  {
    q: 'Which platforms is it available on?',
    a: 'Nintendo Switch, Nintendo Switch 2 and PC via Steam. It launched worldwide on September 16, 2026.',
  },
  {
    q: 'How many playable characters are there?',
    a: '19 playable characters, each with their own party role, character quests and kinship quests.',
  },
  {
    q: 'How many endings does the game have?',
    a: 'New Game+ opens up more than 10 different endings, with a new character joining the journey.',
  },
  {
    q: 'Is there a demo?',
    a: 'Yes — a free demo covers the opening chapters and your save data carries over to the full game.',
  },
  {
    q: 'Which languages are supported?',
    a: 'English, Japanese, Korean, Simplified Chinese and Traditional Chinese, in both text and voice.',
  },
  {
    q: 'What does the DLC add?',
    a: 'Five character packs add 10 more playable characters with their own quests; see the DLC page for the full schedule.',
  },
  {
    q: 'Is there multiplayer?',
    a: 'No — it is strictly single-player, and each journey through the story is your own.',
  },
  {
    q: 'How long is the main story?',
    a: '26 chapters across three eras; a full playthrough plus New Game+ takes dozens of hours depending on how much you explore.',
  },
  {
    q: 'Can I use a controller?',
    a: 'Yes — the Steam version offers full controller support.',
  },
  {
    q: 'Is there cloud saving?',
    a: 'Yes — Steam saves sync to the cloud automatically.',
  },
  {
    q: 'Do I need to play the original game first?',
    a: 'No — this is a standalone story, and newcomers can start fresh without prior knowledge.',
  },
  {
    q: 'Is there an official Discord?',
    a: 'No official Discord has been confirmed. The active community hub is the Reddit community r/AnotherEdenGlobal.',
  },
];

const charQuick = [
  {
    name: 'Aldo',
    line: 'The protagonist, wielding a fire sword. His chain skill builds quickly and piles on damage over long fights.',
    role: 'Damage', element: 'Fire', weapon: 'Sword',
  },
  {
    name: 'Feinne',
    line: 'Aldo’s sister and the party’s anchor — she heals, clears status ailments and shields allies in tight battles.',
    role: 'Support', element: 'Light', weapon: 'Staff',
  },
  {
    name: 'Riica',
    line: 'An android who switches between a battle mode and a support mode, adapting to what the fight needs.',
    role: 'Flexible', element: 'Neutral', weapon: 'Android',
  },
  {
    name: 'Amy',
    line: 'A wind-using hunter from the present era who fights with fists and quick multi-hit techniques.',
    role: 'Damage', element: 'Wind', weapon: 'Fists',
  },
  {
    name: 'Cyrus',
    line: 'A mysterious frog samurai wielding Enku Jizai sword arts, recruited early in the future era.',
    role: 'Damage', element: 'Water', weapon: 'Katana',
  },
];

// —— 站内快速搜索索引（精简标签，避免在 HTML 内重复完整关键词）——
const searchIndex = [
  { slug: 'guide', t: 'Beginner Guide', d: 'Core systems, party setup, battles, progression and essential mechanics' },
  { slug: 'characters', t: 'Characters', d: 'Every playable companion — recruitment, roles, skills, quests and progression' },
  { slug: 'story', t: 'Story', d: 'Story across three eras — New Game+, endings and play time' },
  { slug: 'platforms', t: 'Platforms', d: 'Switch, Switch 2 and Steam platforms, plus the PS5 status' },
  { slug: 'dlc', t: 'DLC', d: 'Season Pass, character packs, prices and the 2026 schedule' },
];
const comingSoon = [
  { slug: 'codes', t: 'Codes', d: 'Active redeem codes' },
  { slug: 'tier-list', t: 'Tier List', d: 'Best character rankings' },
  { slug: 'release-date', t: 'Release Date', d: 'Release date, price and pre-order' },
  { slug: 'demo', t: 'Demo', d: 'Demo guide and details' },
  { slug: 'editions', t: 'Editions', d: 'Physical & collector’s editions' },
  { slug: 'review', t: 'Review', d: 'Review and gameplay analysis' },
  { slug: 'vs-another-eden', t: 'Vs Another Eden', d: 'Differences between the two games' },
  { slug: 'gacha', t: 'Gacha', d: 'Gacha system guide' },
  { slug: 'language', t: 'Language', d: 'Supported languages' },
  { slug: 'voice-actors', t: 'Voice Actors', d: 'Voice cast list' },
];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout title="Another Eden Begins Wiki — Guides, Characters & DLC" path="/">
  <!-- ===== Hero ===== -->
  <section class="hero" id="top">
    <div class="hero-stars" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <div>
        <span class="eyebrow">{hero.eyebrow}</span>
        <h1>Another Eden <em>Begins</em></h1>
        <p class="hero-desc">{hero.description}</p>
        <div class="hero-stats">
          {hero.stats.map((s) => (
            <div class="stat"><b>{s.value}</b><span>{s.label}</span></div>
          ))}
        </div>
        <div class="cta-row">
          <a class="btn btn-primary" href="/guide">Start Beginner Guide</a>
          <a class="btn btn-gold" href="/characters">Meet the Characters</a>
          <a class="btn btn-ghost" href="/dlc">Explore DLC</a>
          <a class="btn btn-ghost" href="https://www.youtube.com/watch?v=HTdLYm94TZA" target="_blank" rel="noopener">Official media</a>
        </div>
      </div>
      <div class="hero-media">
        <div class="frame">
          <img src="/assets/hero-keyart.jpg" alt="Another Eden Begins official key art featuring Aldo with a blazing sword, Feinne and a black cat" width="480" height="384">
          <span class="cap">Official key art · ©WFS</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Start Here ===== -->
  <section class="section" id="start">
    <div class="wrap">
      <div class="section-head">
        <div class="kicker">Start Here</div>
        <h2>Your Another Eden Begins Journey</h2>
        <p>Four entry points into the wiki — from your first command battle to all ten endings.</p>
      </div>
      <form class="search-box" id="quickSearch" role="search">
        <div class="search-row">
          <input type="search" id="searchInput" placeholder="Search the wiki — try “tier list”, “ps5”, “demo”…" aria-label="Search the wiki">
          <button type="submit" id="searchBtn">Search</button>
        </div>
        <div class="search-hint">Try “demo”, “ps5”, “tier list”, “DLC” or a character name — pages still in the rollout are shown as coming soon. No matches open a Google site search.</div>
        <p class="search-note">No account needed — search above, open any entry point, and jump straight to the section you need. Pages for codes, tier lists, releases, reviews and more are on the way.</p>
        <ul class="search-results" id="searchResults" hidden></ul>
      </form>
      <script type="application/json" id="searchIndex" set:html={JSON.stringify(searchIndex)} />
      <script type="application/json" id="comingSoonData" set:html={JSON.stringify(comingSoon)} />
      <div class="start-cards">
        {featured.map((g, i) => (
          <article class="start-card">
            <div class="start-num">0{i + 1}</div>
            <h3>{g.title}</h3>
            <p>{g.description}</p>
            <a class="go" href={`/${g.slug}`}>Read guide
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          </article>
        ))}
      </div>
      <p class="start-note">Each entry point above leads to a dedicated page: the guide walks through mechanics chapter by chapter, the characters page lists the full roster with roles and quests, the story page maps every chapter plus New Game+ endings, and the DLC page tracks the season pass schedule. Platforms covers Switch, Switch 2 and Steam details, including the current PS5 status. If a topic you are looking for is missing, the search box will tell you what is live and what is coming next.</p>
    </div>
  </section>

  <!-- ===== About ===== -->
  <section class="section sec-accent" id="about">
    <div class="wrap">
      <div class="about-grid">
        <div class="about-media">
          <img src="/assets/world-scene.jpg" alt="A lone traveler looks out over a ruined fantastical landscape in Another Eden Begins" width="599" height="337" loading="lazy">
        </div>
        <div class="about-copy">
          <div class="kicker">The Game</div>
          <h2>What is Another Eden Begins?</h2>
          <p>It is a single-player time-traveling RPG developed by <b>WRIGHT FLYER STUDIOS</b> and created with scenario writer and director <b>Masato Kato</b>. Players follow <b>Aldo</b> across different eras while trying to save his sister <b>Feinne</b>.</p>
          <p>The game features strategic command battles, chain skills, Another Force, character quests, kinship quests, crafting, and a New Game+ mode with a new character and more than 10 different endings.</p>
          <p>Behind it is a pedigree JRPG team: scenario director Masato Kato and composer Yasunori Mitsuda return for Begins, and their fingerprints show in the chapter structure, the era-spanning timeline, and the way companion quests unfold. Whether you played the original mobile title or are coming in fresh, this hub collects the essentials — how battles work, who every character is, where the story goes, and what each platform and DLC pack offers.</p>
          <div class="about-facts">
            {aboutStats.map((f) => (
              <div class="fact"><div class="k">{f.label}</div><div class="v">{f.value}</div></div>
            ))}
          </div>
          <div class="cta-row">
            <a class="btn btn-primary" href="/guide">Explore All Guides</a>
            <a class="btn btn-gold" href="/platforms">See Platforms</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Core Features ===== -->
  <section class="section" id="features">
    <div class="wrap">
      <div class="section-head">
        <div class="kicker">Game Systems</div>
        <h2>Core Features at a Glance</h2>
        <p>The mechanics that define the experience, summarized for new players before you dive into the full guides.</p>
      </div>
      <div class="feat-grid">
        <article class="feat-card">
          <div class="feat-num">01</div>
          <h3>Command Battles</h3>
          <p>Turn-based fights with no random encounters — enemies are visible on the field before combat begins.</p>
        </article>
        <article class="feat-card">
          <div class="feat-num">02</div>
          <h3>Another Force</h3>
          <p>Attacks charge a shared gauge; when full, it unlocks continuous follow-up attacks from the whole party.</p>
        </article>
        <article class="feat-card">
          <div class="feat-num">03</div>
          <h3>A Roster of 19</h3>
          <p>Each companion brings a party role, skill trees, personal quests and kinship quests that tie them together.</p>
        </article>
        <article class="feat-card">
          <div class="feat-num">04</div>
          <h3>Time Travel</h3>
          <p>One story spans three eras — an ancient world of spirits, a present kingdom and a skybound future city.</p>
        </article>
        <article class="feat-card">
          <div class="feat-num">05</div>
          <h3>Cat Codex</h3>
          <p>Register 56 cats across the world to let them follow Aldo — a classic collectible running thread.</p>
        </article>
        <article class="feat-card">
          <div class="feat-num">06</div>
          <h3>New Game+</h3>
          <p>Carry your party into a second run with a new companion, exclusive gear and branching endings.</p>
        </article>
        <article class="feat-card">
          <div class="feat-num">07</div>
          <h3>Crafting &amp; Respec</h3>
          <p>Forge gear from materials, and reset ability points anytime with the River of Time Water.</p>
        </article>
        <article class="feat-card">
          <div class="feat-num">08</div>
          <h3>Free Demo</h3>
          <p>Play the opening chapters for free on any platform, with save data that carries into the full release.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ===== Characters ===== -->
  <section class="section sec-accent" id="characters">
    <div class="wrap">
      <div class="char-grid">
        <div class="char-main">
          <img src="/assets/characters-group.jpg" alt="Five playable characters from Another Eden Begins: Cyrus, Amy, Aldo, Feinne and Riica" width="1920" height="1157" loading="lazy">
        </div>
        <div class="char-side">
          <div class="kicker">The Cast</div>
          <h2>Meet the Characters</h2>
          <p>The game ships with <b>19 playable characters</b>. Each one brings a party role, personal quests and kinship quests — from the swordsman Aldo to the frog samurai Cyrus, the hunter Amy and the princess Feinne.</p>
          <p>Character quests deepen the story one companion at a time, while kinship quests tie the party together across eras.</p>
          <div class="char-tags">
            <span>Aldo</span><span>Feinne</span><span>Cyrus</span><span>Amy</span><span>Riica</span><span>19 total</span>
          </div>
          <div class="char-quick">
            <div class="char-tabs">
              {charQuick.map((c) => (
                <button type="button" class:list={{ 'char-tab': true, active: c.name === 'Aldo' }}>{c.name}</button>
              ))}
            </div>
            <div class="char-panels">
              {charQuick.map((c) => (
                <div class:list={{ 'char-panel': true, active: c.name === 'Aldo' }}>
                  <b>{c.name}</b>
                  <p>{c.line}</p>
                  <div class="char-chips">
                    <span>Role · {c.role}</span><span>Element · {c.element}</span><span>Weapon · {c.weapon}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
          <div class="cta-row" style="margin-top:26px;">
            <a class="btn btn-primary" href="/characters">Read the Character Guide</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Story ===== -->
  <section class="section" id="story">
    <div class="wrap">
      <div class="section-head">
        <div class="kicker">Story &amp; Chapters</div>
        <h2>One Journey Across Eras</h2>
        <p>Follow Aldo as he travels between the ancient, present and future eras of the Another Eden world to save his sister Feinne — and discover how Begins fits into the larger Another Eden universe.</p>
        <p class="story-note">The timeline splits into three playable eras — antiquity, present and future — and how you move between them shapes which companions you meet and which endings you can reach.</p>
      </div>
      <div class="start-cards">
        <article class="start-card">
          <div class="start-num">ANTIQUITY</div>
          <h3>Ancient Eras</h3>
          <p>Journey into the distant past, where spirits, elementals and kings shape a world before written memory.</p>
        </article>
        <article class="start-card">
          <div class="start-num">PRESENT</div>
          <h3>The Present</h3>
          <p>Begin in Baruoki Village with Aldo and Feinne — and the day everything changed.</p>
        </article>
        <article class="start-card">
          <div class="start-num">FUTURE</div>
          <h3>The Future</h3>
          <p>Humanity escaped to the skies — the Shining City of Elzion casts light, and a bitter shadow.</p>
        </article>
        <article class="start-card">
          <div class="start-num">NG+</div>
          <h3>New Game+ &amp; Endings</h3>
          <p>After the main story, New Game+ opens a new character and more than 10 different endings.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ===== News 时间轴 ===== -->
  <section class="section sec-accent" id="news">
    <div class="wrap">
      <div class="section-head">
        <div class="kicker">Signal · News</div>
        <h2>Latest News</h2>
        <p>Key milestones for the game, tracked from official sources.</p>
      </div>
      <div class="timeline">
        <div class="tl-item l">
          <div class="tl-date">Sep 16, 2026</div>
          <div class="tl-title">Worldwide launch</div>
          <div class="tl-desc">The game launches on Steam, Nintendo Switch and Switch 2 — published by Wright Flyer Studios / STUDIO PRISMA.</div>
        </div>
        <div class="tl-axis"><div class="dot"></div><div class="line"></div></div>
        <div></div>

        <div></div>
        <div class="tl-axis"><div class="dot"></div><div class="line"></div></div>
        <div class="tl-item r">
          <div class="tl-date">Sep 17, 2026</div>
          <div class="tl-title">Final Trailer released</div>
          <div class="tl-desc">Wright Flyer Studios publishes the official Final Trailer for the game.</div>
        </div>

        <div class="tl-item l">
          <div class="tl-date">Sep 2026</div>
          <div class="tl-title">Tokyo Game Show 2026</div>
          <div class="tl-desc">Hands-on playable builds are available at Tokyo Game Show 2026.</div>
        </div>
        <div class="tl-axis"><div class="dot"></div><div class="line"></div></div>
        <div></div>

        <div></div>
        <div class="tl-axis"><div class="dot"></div></div>
        <div class="tl-item r">
          <div class="tl-date">Live</div>
          <div class="tl-title">Steam: Mostly Positive · 72%</div>
          <div class="tl-desc">Current Steam user rating, based on 110 reviews at launch.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== FAQ ===== -->
  <section class="section" id="faq">
    <div class="wrap">
      <div class="section-head">
        <div class="kicker">Quick Answers</div>
        <h2>Frequently Asked Questions</h2>
        <p>The questions new players ask most.</p>
      </div>
      <div class="faq-list">
        {faqs.map((f, i) => (
          <div class:list={{ 'faq-item': true, open: i === 0 }}>
            <div class="faq-q"><span class="mark">+</span> {f.q}</div>
            <div class="faq-a">{f.a}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== 最终 CTA ===== -->
  <section class="final-cta">
    <div class="kicker">Ready to begin?</div>
    <h2>Ready to Master the Adventure?</h2>
    <p>From your first steps with Aldo to character quests, strategic battles, New Game+, and its many endings, our community wiki brings the key information together.</p>
    <p>Everything here is written by fans, checked against official sources, and updated as patches, DLC and community discoveries land. Bookmark the page — new guides are added to the roadmap as soon as they have real content to share.</p>
    <div class="cta-row" style="justify-content:center;">
      <a class="btn btn-primary" href="/guide">Read the Beginner Guide</a>
      <a class="btn btn-gold" href="https://anothereden.games/en/" target="_blank" rel="noopener">Play Another Eden Begins</a>
    </div>
  </section>

  <!-- FAQPage 结构化数据 -->
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <script>
    (function () {
      var tabs = document.querySelectorAll('.char-tab');
      var panels = document.querySelectorAll('.char-panel');
      for (var i = 0; i < tabs.length; i++) {
        (function (tab, idx) {
          tab.addEventListener('click', function () {
            for (var j = 0; j < tabs.length; j++) { tabs[j].classList.remove('active'); }
            for (var k = 0; k < panels.length; k++) { panels[k].classList.remove('active'); }
            tab.classList.add('active');
            panels[idx].classList.add('active');
          });
        })(tabs[i], i);
      }
    })();
  </script>
  <script>
    (function () {
      var input = document.getElementById('searchInput');
      var results = document.getElementById('searchResults');
      var form = document.getElementById('quickSearch');
      if (!input || !results || !form) return;
      var idxNode = document.getElementById('searchIndex');
      var comingNode = document.getElementById('comingSoonData');
      var idx = idxNode ? JSON.parse(idxNode.textContent) : [];
      var coming = comingNode ? JSON.parse(comingNode.textContent) : [];
      function runSearch() {
        var q = input.value.trim().toLowerCase();
        results.innerHTML = '';
        if (q.length < 2) { results.hidden = true; return; }
        var hits = idx.filter(function (p) {
          return (p.t + ' ' + p.d).toLowerCase().indexOf(q) !== -1;
        });
        var comingHits = coming.filter(function (p) {
          return (p.t + ' ' + p.d).toLowerCase().indexOf(q) !== -1;
        });
        if (!hits.length && !comingHits.length) {
          var li = document.createElement('li');
          li.className = 'sr-none';
          li.textContent = 'No matching pages yet — opening a site search for “' + input.value + '”…';
          results.appendChild(li);
          setTimeout(function () {
            window.open('https://www.google.com/search?q=site%3Aanotheredenbegins.com+' + encodeURIComponent(input.value.trim()), '_blank', 'noopener');
          }, 900);
        }
        hits.forEach(function (p) {
          var li = document.createElement('li');
          var a = document.createElement('a');
          a.href = '/' + p.slug + '/';
          a.textContent = p.t;
          li.appendChild(a);
          var d = document.createElement('span');
          d.textContent = p.d;
          li.appendChild(d);
          results.appendChild(li);
        });
        comingHits.forEach(function (p) {
          var li = document.createElement('li');
          li.className = 'sr-coming';
          var b = document.createElement('b');
          b.textContent = p.t + ' — coming soon';
          li.appendChild(b);
          var d = document.createElement('span');
          d.textContent = p.d;
          li.appendChild(d);
          results.appendChild(li);
        });
        results.hidden = false;
      }
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        runSearch();
      });
      input.addEventListener('input', runSearch);
    })();
  </script>
</Layout>
